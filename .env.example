# ============================================
# SIMPLIF'IA FRANCE · Variables d'environnement
# ============================================
# Copiez ce fichier en .env et remplissez les valeurs.
# Ne commitez JAMAIS le fichier .env.

# ---- Application ----
APP_NAME=Simplif-IA-France
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:8080,https://votre-domaine.fr

# ---- Database ----
POSTGRES_USER=simplifia
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=simplifia
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://simplifia:change-me-strong-password@postgres:5432/simplifia

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Sécurité ----
# Générer : python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-with-secrets-token-urlsafe-64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=change-me-fernet-44-chars-base64-key=

# ---- Admin initial ----
ADMIN_EMAIL=admin@simplif-ia.fr
ADMIN_PASSWORD=change-me-strong-admin-password
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Simplifia

# ---- IA (Gemini) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro-latest

# ---- TTS (ElevenLabs) ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=XB0fDUnXU5powFXDhCwa
ELEVENLABS_MODEL=eleven_multilingual_v2

# ---- APIs Gouv.fr (libres, sans clé) ----
API_BAN_URL=https://api-adresse.data.gouv.fr
API_SIRENE_URL=https://recherche-entreprises.api.gouv.fr
API_ANNUAIRE_URL=https://api-lannuaire.service-public.gouv.fr
API_GEO_URL=https://geo.api.gouv.fr

# ---- Légifrance (PISTE OAuth, optionnel) ----
LEGIFRANCE_CLIENT_ID=
LEGIFRANCE_CLIENT_SECRET=

# ---- AR24 LRE (optionnel - production) ----
AR24_API_KEY=
AR24_API_URL=https://app.ar24.fr/api

# ---- Stripe (paiements, optionnel) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email (Brevo / SMTP, optionnel) ----
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@simplif-ia.fr

# ---- Stockage ----
STORAGE_BACKEND=local
STORAGE_PATH=/app/storage
# S3 si STORAGE_BACKEND=s3
S3_BUCKET=
S3_REGION=fr-par
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
